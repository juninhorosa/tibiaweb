{
  "name": "tibiaweb-server",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/node:1": { "version": "22" },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  // 7171 = login, 8443 = mundo do jogo. Cada porta vira um hostname
  // proprio em app.github.dev, sempre publicado na 443 -- que e o
  // formato wss://host:porta que o cliente monta.
  "forwardPorts": [7171, 8443, 8080],
  "portsAttributes": {
    "7171": { "label": "login (wss)", "visibility": "public", "onAutoForward": "silent" },
    "8443": { "label": "game world (wss)", "visibility": "public", "onAutoForward": "silent" },
    "8080": { "label": "cliente web", "visibility": "public", "onAutoForward": "silent" }
  },
  "postCreateCommand": "cd webdeploy/proxy && npm install --omit=dev",

  // Sobe tudo a cada start do codespace. Sem isto, todo restart exige rodar
  // o script na mao -- e esquecer disso rende um 404 confuso, porque as
  // portas so aparecem quando algum processo escuta nelas.
  //
  // fetch + reset --hard, e nao "git pull --rebase || true".
  //
  // O pull com "|| true" falhava em silencio e o start seguia rodando o
  // script ANTIGO: o codespace subia, publicava as portas e parecia saudavel,
  // servindo codigo de versoes atras. Um deploy que mente e pior que um que
  // quebra. O reset garante que o workspace e exatamente origin/main; nada
  // unico mora aqui, o repositorio e a fonte da verdade.
  //
  // Sem "|| true" tambem no reset: se a sincronizacao falhar, e melhor o
  // start falhar alto do que servir a versao errada.
  //
  // Roda em primeiro plano de proposito. Com "nohup ... &" o Codespaces
  // encerra o grupo de processos quando o postStartCommand retorna e mata o
  // filho -- o resultado e um codespace que sobe sem nenhuma porta.
  "postStartCommand": "git -C /workspaces/tibiaweb fetch origin main && git -C /workspaces/tibiaweb reset --hard origin/main && bash /workspaces/tibiaweb/webdeploy/start-codespace.sh 2>&1 | tee /tmp/start-codespace.log"
}
